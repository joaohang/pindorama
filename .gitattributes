# Normaliza fim de linha para texto
* text=auto

# Unity YAML (texto) — ajuda no diff/merge
*.unity text
*.prefab text
*.asset text
*.meta text
*.mat text
*.anim text
*.controller text
*.overrideController text

# Binários (não tentar fazer merge de texto)
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.tga binary
*.tif binary
*.tiff binary
*.exr binary
*.fbx binary
*.obj binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.aiff binary
*.ttf binary
*.otf binary
*.dll binary
*.so binary
*.bundle binary
*.unitypackage binary

# Para assets grandes, o ideal é Git LFS. Exemplo (descomente e rode
# "git lfs install" antes de adicionar os arquivos):
#
# *.png filter=lfs diff=lfs merge=lfs -text
# *.psd filter=lfs diff=lfs merge=lfs -text
# *.wav filter=lfs diff=lfs merge=lfs -text
# *.fbx filter=lfs diff=lfs merge=lfs -text
