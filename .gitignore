# ============================================================
# Pindorama — .gitignore para Unity
# Regra de ouro: NUNCA versionar Library/, Temp/, Logs/ e builds.
# Os arquivos .meta DEVEM ser versionados (fazem parte do projeto).
# ============================================================

# Unity gerado
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Cache de pacotes
/Packages/*.nupkg

# IDEs
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Sistema operacional
.DS_Store
Thumbs.db

# Builds / pacotes
*.apk
*.aab
*.unitypackage
*.app
*.exe

# Crash / logs
sysinfo.txt
*.stackdump
crashlytics-build.properties
